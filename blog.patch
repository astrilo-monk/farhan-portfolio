@@ -0,0 +1,154 @@
+import { useEffect, useState } from "react";
+import { MOODS } from "../blogApi";
+import { useBlogAuth } from "./BlogAuth";
+import Markdown from "./Markdown";
+
+const BODY_MAX = 20000;
+const TITLE_MAX = 120;
+
+export default function BlogEditor({ initial, submitLabel = "publish", onSubmit, onCancel, draftKey }) {
+  const { lock } = useBlogAuth();
+  const [title, setTitle] = useState(initial.title);
+  const [body, setBody] = useState(initial.body);
+  const [mood, setMood] = useState(initial.mood);
+  const [tab, setTab] = useState("write");
+  const [error, setError] = useState("");
+  const [busy, setBusy] = useState(false);
+
+  // Restore an unfinished draft (new posts only), once.
+  useEffect(() => {
+    if (!draftKey || initial.title || initial.body) return;
+    try {
+      const draft = JSON.parse(localStorage.getItem(draftKey) || "null");
+      if (draft) {
+        setTitle(draft.title || "");
+        setBody(draft.body || "");
+        setMood(draft.mood || "hamster");
+      }
+    } catch {
+      // ignore corrupted draft
+    }
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, []);
+
+  // Autosave the draft locally while typing.
+  useEffect(() => {
+    if (!draftKey || (!title && !body)) return undefined;
+    const id = setTimeout(() => {
+      try {
+        localStorage.setItem(draftKey, JSON.stringify({ title, body, mood }));
+      } catch {
+        // storage full or blocked: not critical
+      }
+    }, 500);
+    return () => clearTimeout(id);
+  }, [title, body, mood, draftKey]);
+
+  const submit = async (event) => {
+    event.preventDefault();
+    if (busy) return;
+    setError("");
+    setBusy(true);
+    try {
+      await onSubmit({ title: title.trim(), body, mood });
+      if (draftKey) localStorage.removeItem(draftKey);
+    } catch (err) {
+      if (err.status === 401) lock();
+      setError(err.status === 401 ? "Session expired. Close this and unlock again (your draft is saved)." : err.message);
+      setBusy(false);
+    }
+  };
+
+  return (
+    <form className="win editor" onSubmit={submit}>
+      <div className="win-bar">
+        <span className="win-dots" aria-hidden="true">
+          <i />
+          <i />
+          <i />
+        </span>
+        <span className="win-title">{initial.title ? "edit-post.md" : "new-post.md"}</span>
+        <div className="editor-tabs" role="tablist">
+          {["write", "preview"].map((name) => (
+            <button
+              key={name}
+              type="button"
+              role="tab"
+              aria-selected={tab === name}
+              className={tab === name ? "on" : ""}
+              onClick={() => setTab(name)}
+            >
+              {name}
+            </button>
+          ))}
+        </div>
+      </div>
+
+      <div className="win-body editor-body">
+        <input
+          className="editor-title"
+          value={title}
+          onChange={(event) => setTitle(event.target.value)}
+          maxLength={TITLE_MAX}
+          placeholder="Post title"
+          aria-label="Post title"
+          required
+        />
+
+        <fieldset className="mood-picker">
+          <legend>cover sticker</legend>
+          {MOODS.map((item) => (
+            <button
+              key={item.id}
+              type="button"
+              role="radio"
+              aria-checked={mood === item.id}
+              aria-label={item.label}
+              className={mood === item.id ? "on" : ""}
+              onClick={() => setMood(item.id)}
+            >
+              <img src={item.src} alt="" width="52" height="52" loading="lazy" />
+            </button>
+          ))}
+        </fieldset>
+
+        {tab === "write" ? (
+          <textarea
+            className="editor-text"
+            value={body}
+            onChange={(event) => setBody(event.target.value)}
+            maxLength={BODY_MAX}
+            rows={14}
+            placeholder={"Write anything...\n\n# Heading   **bold**   `code`   - list   > quote   [link](https://...)"}
+            aria-label="Post body"
+            required
+          />
+        ) : (
+          <div className="editor-preview">
+            {body.trim() ? <Markdown source={body} /> : <p className="dim">Nothing to preview yet.</p>}
+          </div>
+        )}
+
+        {error && (
+          <p className="form-error" role="alert">
+            {error}
+          </p>
+        )}
+
+        <div className="editor-foot">
+          <span className="dim">
+            {body.length}/{BODY_MAX}
+          </span>
+          <div className="editor-actions">
+            <button type="button" className="btn" onClick={onCancel}>
+              cancel
+            </button>
+            <button type="submit" className="btn btn-primary" disabled={busy || !title.trim() || !body.trim()}>
+              {busy ? "saving..." : submitLabel}
+            </button>
+          </div>
+        </div>
+      </div>
+    </form>
+  );
+}
diff --git a/src/components/Markdown.jsx b/src/components/Markdown.jsx
new file mode 100644
index 0000000..0317abc
--- /dev/null
+++ b/src/components/Markdown.jsx
@@ -0,0 +1,100 @@
+// A small, safe markdown renderer. It builds React elements (never raw HTML),
+// and only allows http(s) links, so post content cannot inject scripts.
+
+const INLINE = /(`[^`\n]+`)|(\*\*[^*\n]+\*\*)|(\[([^\]\n]+)\]\((https?:\/\/[^\s)]+)\))/g;
+
+function renderInline(text, keyPrefix) {
+  const nodes = [];
+  let last = 0;
+  let index = 0;
+  let match;
+  INLINE.lastIndex = 0;
+
+  while ((match = INLINE.exec(text))) {
+    if (match.index > last) nodes.push(text.slice(last, match.index));
+    const key = `${keyPrefix}-${index}`;
+    index += 1;
+
+    if (match[1]) nodes.push(<code key={key}>{match[1].slice(1, -1)}</code>);
+    else if (match[2]) nodes.push(<strong key={key}>{match[2].slice(2, -2)}</strong>);
+    else
+      nodes.push(
+        <a key={key} href={match[5]} target="_blank" rel="noopener noreferrer">
+          {match[4]}
+        </a>
+      );
+    last = INLINE.lastIndex;
+  }
+  if (last < text.length) nodes.push(text.slice(last));
+  return nodes;
+}
+
+function withBreaks(lines, keyPrefix) {
+  return lines.flatMap((line, i) => (i === 0 ? renderInline(line, `${keyPrefix}-${i}`) : [<br key={`${keyPrefix}-br${i}`} />, ...renderInline(line, `${keyPrefix}-${i}`)]));
+}
+
+export default function Markdown({ source }) {
+  const lines = source.replace(/\r\n/g, "\n").split("\n");
+  const blocks = [];
+  let i = 0;
+
+  while (i < lines.length) {
+    const line = lines[i];
+    const key = `b${blocks.length}`;
+
+    if (/^```/.test(line)) {
+      const code = [];
+      i += 1;
+      while (i < lines.length && !/^```/.test(lines[i])) {
+        code.push(lines[i]);
+        i += 1;
+      }
+      i += 1;
+      blocks.push(
+        <pre key={key}>
+          <code>{code.join("\n")}</code>
+        </pre>
+      );
+    } else if (/^#{1,3}\s+/.test(line)) {
+      const level = line.match(/^#+/)[0].length;
+      const Tag = `h${level + 1}`; // post title is the h1
+      blocks.push(<Tag key={key}>{renderInline(line.replace(/^#+\s+/, ""), key)}</Tag>);
+      i += 1;
+    } else if (/^>\s?/.test(line)) {
+      const quote = [];
+      while (i < lines.length && /^>\s?/.test(lines[i])) {
+        quote.push(lines[i].replace(/^>\s?/, ""));
+        i += 1;
+      }
+      blocks.push(<blockquote key={key}>{withBreaks(quote, key)}</blockquote>);
+    } else if (/^[-*]\s+/.test(line)) {
+      const items = [];
+      while (i < lines.length && /^[-*]\s+/.test(lines[i])) {
+        items.push(lines[i].replace(/^[-*]\s+/, ""));
+        i += 1;
+      }
+      blocks.push(
+        <ul key={key}>
+          {items.map((item, n) => (
+            <li key={n}>{renderInline(item, `${key}-${n}`)}</li>
+          ))}
+        </ul>
+      );
+    } else if (line.trim() === "") {
+      i += 1;
+    } else {
+      const para = [];
+      while (
+        i < lines.length &&
+        lines[i].trim() !== "" &&
+        !/^(```|#{1,3}\s|>\s?|[-*]\s)/.test(lines[i])
+      ) {
+        para.push(lines[i]);
+        i += 1;
+      }
+      blocks.push(<p key={key}>{withBreaks(para, key)}</p>);
+    }
+  }
+
+  return <div className="prose">{blocks}</div>;
+}
diff --git a/src/pages/BlogPage.jsx b/src/pages/BlogPage.jsx
