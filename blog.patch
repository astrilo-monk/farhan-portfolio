diff --git a/server/blogAuth.js b/server/blogAuth.js
new file mode 100644
index 0000000..a5a82ca
--- /dev/null
+++ b/server/blogAuth.js
@@ -0,0 +1,52 @@
+import crypto from "node:crypto";
+
+// The blog password lives ONLY in the BLOG_PASSWORD environment variable on the
+// server. It is never sent to the browser. Logging in swaps the password for a
+// short-lived signed token; every write request must carry a valid token.
+
+const TOKEN_TTL_MS = 4 * 60 * 60 * 1000; // 4 hours
+
+export const passwordConfigured = () => {
+  const pw = process.env.BLOG_PASSWORD;
+  return typeof pw === "string" && pw.length >= 8;
+};
+
+const sha256 = (value) => crypto.createHash("sha256").update(String(value)).digest();
+
+// Hash both sides so lengths match, then compare in constant time.
+export const passwordMatches = (input) => crypto.timingSafeEqual(sha256(input), sha256(process.env.BLOG_PASSWORD));
+
+// Signing key is derived from the password, so changing BLOG_PASSWORD
+// instantly invalidates every token that was already issued.
+const signingKey = () => crypto.createHmac("sha256", process.env.BLOG_PASSWORD).update("blog-token-v1").digest();
+
+const sign = (payload) => crypto.createHmac("sha256", signingKey()).update(payload).digest("base64url");
+
+export function issueToken() {
+  const expiresAt = Date.now() + TOKEN_TTL_MS;
+  const payload = Buffer.from(JSON.stringify({ exp: expiresAt })).toString("base64url");
+  return { token: `${payload}.${sign(payload)}`, expiresAt };
+}
+
+export function verifyToken(token) {
+  if (!token || !passwordConfigured()) return false;
+  const [payload, signature] = String(token).split(".");
+  if (!payload || !signature) return false;
+
+  const expected = Buffer.from(sign(payload));
+  const given = Buffer.from(signature);
+  if (expected.length !== given.length || !crypto.timingSafeEqual(expected, given)) return false;
+
+  try {
+    return JSON.parse(Buffer.from(payload, "base64url").toString("utf8")).exp > Date.now();
+  } catch {
+    return false;
+  }
+}
+
+export const bearerToken = (req) => String(req.headers.authorization || "").replace(/^Bearer\s+/i, "");
+
+export const clientIp = (req) =>
+  String(req.headers["x-forwarded-for"] || req.socket?.remoteAddress || "unknown")
+    .split(",")[0]
+    .trim();
diff --git a/server/blogStore.js b/server/blogStore.js
new file mode 100644
index 0000000..26c76fe
--- /dev/null
+++ b/server/blogStore.js
@@ -0,0 +1,63 @@
+// Blog storage on Upstash Redis via its REST API (no extra dependency).
+// Vercel's Upstash integration provides either UPSTASH_REDIS_REST_* or the
+// older KV_REST_API_* variables, so both are supported.
+
+const POSTS_KEY = "blog:posts";
+const LIMIT_WINDOW_SECONDS = 600;
+
+const redisUrl = () => process.env.UPSTASH_REDIS_REST_URL || process.env.KV_REST_API_URL;
+const redisToken = () => process.env.UPSTASH_REDIS_REST_TOKEN || process.env.KV_REST_API_TOKEN;
+
+export const storageConfigured = () => Boolean(redisUrl() && redisToken());
+
+async function run(commands) {
+  const response = await fetch(`${redisUrl().replace(/\/$/, "")}/pipeline`, {
+    method: "POST",
+    headers: { Authorization: `Bearer ${redisToken()}`, "Content-Type": "application/json" },
+    body: JSON.stringify(commands)
+  });
+  if (!response.ok) throw new Error(`Redis responded with ${response.status}`);
+
+  const results = await response.json();
+  const failed = results.find((entry) => entry.error);
+  if (failed) throw new Error(failed.error);
+  return results.map((entry) => entry.result);
+}
+
+export async function listPosts() {
+  const [raw] = await run([["HGETALL", POSTS_KEY]]);
+  const pairs = Array.isArray(raw) ? raw : Object.entries(raw || {}).flat();
+  const posts = [];
+  for (let i = 1; i < pairs.length; i += 2) {
+    try {
+      posts.push(JSON.parse(pairs[i]));
+    } catch {
+      // skip a corrupted entry instead of failing the whole list
+    }
+  }
+  return posts.sort((a, b) => b.createdAt.localeCompare(a.createdAt));
+}
+
+export async function getPost(id) {
+  const [raw] = await run([["HGET", POSTS_KEY, id]]);
+  return raw ? JSON.parse(raw) : null;
+}
+
+export const savePost = (post) => run([["HSET", POSTS_KEY, post.id, JSON.stringify(post)]]);
+
+export const deletePost = (id) => run([["HDEL", POSTS_KEY, id]]);
+
+// ----- failed-login limiter (per IP) -----
+const limitKey = (ip) => `blog:login-fails:${ip}`;
+
+export async function failedAttempts(ip) {
+  const [count] = await run([["GET", limitKey(ip)]]);
+  return Number(count) || 0;
+}
+
+export async function recordFailure(ip) {
+  const [count] = await run([["INCR", limitKey(ip)]]);
+  if (count === 1) await run([["EXPIRE", limitKey(ip), LIMIT_WINDOW_SECONDS]]);
+}
+
+export const clearFailures = (ip) => run([["DEL", limitKey(ip)]]);
